@page "/chatgpt"
@rendermode InteractiveServer
@inject HttpClient Http
@using Microsoft.AspNetCore.Components.Web
@using System.Text
@using System.Net.Http
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Newtonsoft.Json
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using System.Threading.Tasks
@using System;
@using MongoDB.Driver
@using MongoDB.Bson

<PageTitle>ChatGPT Client</PageTitle>

<div class="container-fluid mt-3">
    <div class="row">

        @* Chat Display Area *@
        <div class="col-md-8">
            <div class="mb-3">
                <label for="chatOutputTextArea" class="form-label">聊天记录</label>
                <textarea id="chatOutputTextArea" class="form-control" rows="20" readonly>@chatOutput</textarea>
            </div>

            <div class="input-group mb-3">
                <input type="text" @bind="userInput" class="form-control" placeholder="输入消息..." @onkeydown="HandleKeyDown" />

                <button class="btn btn-primary" type="button" @onclick="SendMessageAsync" disabled="@isSending">
                    @if (isSending)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> 发送中...</span>
                    }
                    else
                    {
                        <span>发送</span>
                    }
                </button>

            </div>
             @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessage
                </div>
            }
        </div>

        @* Configuration Area *@
        <div class="col-md-4">
            <h5>配置</h5>
            <div class="mb-3">
                <label for="systemPrompt" class="form-label">系统提示词:</label>
                <textarea id="systemPrompt" class="form-control form-control-sm" rows="3" @bind="systemPrompt"></textarea>
            </div>
            <div class="row mb-2 align-items-center">
                <label for="historyCount" class="col-sm-6 col-form-label">历史记录数量:</label>
                <div class="col-sm-6">
                    <input type="number" id="historyCount" class="form-control form-control-sm" @bind="historyCount" />
                </div>
            </div>

            <div class="row mb-2 align-items-center">
                 <label class="col-sm-6 col-form-label">启用历史限制:</label>
                 <div class="col-sm-6">
                     <div class="form-check form-switch">
                         <input class="form-check-input" type="checkbox" role="switch" id="enableHistoryLimit" @bind="enableHistoryLimit">
                         <label class="form-check-label" for="enableHistoryLimit"></label>
                     </div>
                 </div>
            </div>

            <div class="row mb-2 align-items-center">
                <label for="dbName" class="col-sm-6 col-form-label">MongoDB 数据库:</label>
                <div class="col-sm-6">
                    <input type="text" id="dbName" class="form-control form-control-sm" @bind="mongoDBDatabaseName" />
                </div>
            </div>

            <div class="row mb-2 align-items-center">
                <label for="geminiUrl" class="col-sm-6 col-form-label">Gemini API URL:</label>
                <div class="col-sm-6">
                    <input type="text" id="geminiUrl" class="form-control form-control-sm" @bind="geminiApiUrl" />
                </div>
            </div>

            <div class="row mb-2 align-items-center">
                <label for="geminiKey" class="col-sm-6 col-form-label">Gemini API Key:</label>
                <div class="col-sm-6">
                    <input type="password" id="geminiKey" class="form-control form-control-sm" @bind="geminiApiKey" />
                </div>
            </div>

            <div class="row mb-2 align-items-center">
                <label for="modelName" class="col-sm-6 col-form-label">模型名称:</label>
                <div class="col-sm-6">
                    <input type="text" id="modelName" class="form-control form-control-sm" @bind="modelName" />
                </div>
            </div>

            <div class="row mb-2 align-items-center">
                <label for="temperature" class="col-sm-6 col-form-label">Temperature:</label>
                <div class="col-sm-6">
                    <input type="number" step="0.1" id="temperature" class="form-control form-control-sm" @bind="temperature" />
                </div>
            </div>

            <div class="row mb-2 align-items-center">
                <label for="topP" class="col-sm-6 col-form-label">Top P:</label>
                <div class="col-sm-6">
                    <input type="number" step="0.1" id="topP" class="form-control form-control-sm" @bind="topP" />
                </div>
            </div>

            <div class="row mb-2 align-items-center">
                <label for="topK" class="col-sm-6 col-form-label">Top K:</label>
                <div class="col-sm-6">
                    <input type="number" id="topK" class="form-control form-control-sm" @bind="topK" />
                </div>
            </div>


            <div class="row mb-2 align-items-center">
                <label for="outputLevel" class="col-sm-6 col-form-label">输出级别 (1-3):</label>
                <div class="col-sm-6">
                    <input type="number" id="outputLevel" class="form-control form-control-sm" @bind="outputLevel" />
                </div>
            </div>



        </div>
    </div>
</div>

@code {
    private string? userInput;
    private StringBuilder chatOutputBuilder = new StringBuilder();
    private string chatOutput => chatOutputBuilder.ToString(); // Simplified getter
    private List<ChatMessage> chatHistory = new List<ChatMessage>();
    private bool isSending = false;
    private string? errorMessage = null;
    private string? systemPrompt { get; set; }

    private int outputLevel = 3; // Default level is 3

    private static readonly string defaultGeminiApiUrl = "https://gemini.abc15018045126.ip-ddns.com/v1/chat/completions";
    private static readonly string defaultGeminiApiKey = "AIzaSyDmGfx7r-MP8XglVrGkcG51JtTsqSH31uI";
    private static readonly string defaultModelName = "gemini-2.0-flash";
    private static readonly string defaultMongoConnectionString = "mongodb://localhost:27017";

    private int historyCount = 10;
    private bool enableHistoryLimit = true; // Set default value to true
    private string mongoDBDatabaseName = "ChatGPTDB";
    private string geminiApiUrl = defaultGeminiApiUrl;
    private string geminiApiKey = defaultGeminiApiKey;
    private string modelName = defaultModelName;
    private double? temperature;
    private double? topP;
    private int? topK;

    private IMongoClient? mongoClient;
    private IMongoDatabase? database;
    private IMongoCollection<BsonDocument>? chatLogsCollection;

    protected override async Task OnInitializedAsync()
    {
        InitializeMongoDB();
        await LoadChatHistoryFromDBAsync();
        // --- 修改：仅在 Level 3 输出初始化信息 ---
        if (outputLevel == 3) AppendMessageToOutput("DEBUG: ChatGPT component initialized.");
    }

    private void InitializeMongoDB()
    {
        try
        {
            mongoClient = new MongoClient(defaultMongoConnectionString);
            database = mongoClient.GetDatabase(mongoDBDatabaseName);
            chatLogsCollection = database.GetCollection<BsonDocument>("ChatLogs");
            // --- 修改：仅在 Level 3 输出 MongoDB 初始化信息 ---
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: MongoDB initialized. Database: {mongoDBDatabaseName}, Collection: ChatLogs");
        }
        catch (Exception ex)
        {
             errorMessage = $"Error initializing MongoDB: {ex.Message}";
             // --- 修改：仅在 Level 3 输出 MongoDB 错误信息 ---
             if (outputLevel == 3) AppendMessageToOutput($"DEBUG: MongoDB initialization failed: {ex.Message}");
             mongoClient = null;
             database = null;
             chatLogsCollection = null;
        }
    }

    private async Task LoadChatHistoryFromDBAsync()
    {
        if (chatLogsCollection == null)
        {
            // --- 修改：仅在 Level 3 输出跳过信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: LoadChatHistoryFromDBAsync skipped - MongoDB not initialized.");
            return;
        }

        if (!enableHistoryLimit || historyCount <= 0)
        {
             // --- 修改：仅在 Level 3 输出跳过信息 ---
             if (outputLevel == 3) AppendMessageToOutput("DEBUG: LoadChatHistoryFromDBAsync skipped - History limit disabled or count is zero.");
             return;
        }


        try
        {
            // --- 修改：仅在 Level 3 输出加载信息 ---
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: Loading last {historyCount} chat entries from MongoDB...");

            var filter = Builders<BsonDocument>.Filter.Empty;
            var sort = Builders<BsonDocument>.Sort.Descending("Timestamp");
            var options = new FindOptions<BsonDocument>
            {
                Sort = sort,
                Limit = historyCount
            };

            var recentLogs = await chatLogsCollection.FindAsync(filter, options);
            var loadedLogs = await recentLogs.ToListAsync();

            chatHistory.Clear();
            chatOutputBuilder.Clear(); // Clear builder before loading

            for (int i = loadedLogs.Count - 1; i >= 0; i--)
            {
                var log = loadedLogs[i];
                if (log.TryGetValue("UserInput", out var userBson) && userBson.IsString &&
                    log.TryGetValue("GeminiResponse", out var geminiBson) && geminiBson.IsString)
                {
                    string userInput = userBson.AsString;
                    string geminiResponse = geminiBson.AsString;

                    chatHistory.Add(new ChatMessage { role = "user", content = userInput });
                    chatHistory.Add(new ChatMessage { role = "assistant", content = geminiResponse });

                    // --- Level 1+: Always show user and Gemini messages ---
                    AppendMessageToOutput($"You: {userInput}");
                    AppendMessageToOutput($"Gemini: {geminiResponse}");
                }
                else
                {
                     // --- 修改：仅在 Level 3 输出警告信息 ---
                     if (outputLevel == 3) AppendMessageToOutput($"WARN: Skipping invalid log entry from DB: {log.ToJson()}");
                }
            }

            // --- 修改：仅在 Level 3 输出加载完成信息 ---
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: Loaded {loadedLogs.Count} entries ({chatHistory.Count} messages) from MongoDB.");
            StateHasChanged(); // Update UI after loading
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading chat history from MongoDB: {ex.Message}";
            // --- 修改：仅在 Level 3 输出加载错误信息 ---
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: Error loading chat history: {ex.Message}");
        }
    }


    private async Task SendMessageAsync()
    {
        // --- 修改：仅在 Level 3 输出进入函数信息 ---
        if (outputLevel == 3) AppendMessageToOutput("DEBUG: SendMessageAsync entered.");

        if (string.IsNullOrWhiteSpace(userInput))
        {
            // --- 修改：仅在 Level 3 输出空输入信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: SendMessageAsync returning - userInput is null or whitespace.");
            return;
        }
        if (isSending)
        {
            // --- 修改：仅在 Level 3 输出正在发送信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: SendMessageAsync returning - isSending is true.");
            return;
        }

        // --- 修改：仅在 Level 3 输出设置状态信息 ---
        if (outputLevel == 3) AppendMessageToOutput("DEBUG: SendMessageAsync - Setting isSending = true.");
        isSending = true;
        errorMessage = null;
        StateHasChanged();

        string currentUserInput = userInput;
        userInput = string.Empty;
        // --- 修改：仅在 Level 3 输出捕获输入信息 ---
        if (outputLevel == 3) AppendMessageToOutput($"DEBUG: SendMessageAsync - Captured input: '{currentUserInput}'. Input box cleared.");

        try
        {
            // --- Level 1+: Always show user message ---
            AppendMessageToOutput($"You: {currentUserInput}");
            // --- 修改：仅在 Level 3 输出调用 API 信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: SendMessageAsync - About to call CallGeminiApiAsync.");

            // --- Call Gemini API ---
            string geminiResponse = await CallGeminiApiAsync(currentUserInput);
            // --- 修改：仅在 Level 3 输出 API 调用完成信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: SendMessageAsync - CallGeminiApiAsync completed.");

            if (!geminiResponse.StartsWith("Error:"))
            {
                // --- Level 1+: Always show Gemini response if successful ---
                AppendMessageToOutput($"Gemini: {geminiResponse}");
                SaveChatLog(currentUserInput, geminiResponse); // Save only successful interactions
            }
            else
            {
                 // --- 修改：仅在 Level 3 输出 API 错误信息 ---
                 if (outputLevel == 3) AppendMessageToOutput($"DEBUG: SendMessageAsync - Received error from CallGeminiApiAsync: {geminiResponse}");
                 // Optionally display the error in the chat window regardless of level?
                 // AppendMessageToOutput(geminiResponse); // Uncomment if you want errors shown in chat
            }
        }
        catch (Exception ex)
        {
            // --- 修改：仅在 Level 3 输出异常信息 ---
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: SendMessageAsync - Exception caught: {ex.Message}");
            errorMessage = $"Error: {ex.Message}\n{ex.StackTrace}";
        }
        finally
        {
            // --- 修改：仅在 Level 3 输出 finally 块信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: SendMessageAsync - Finally block entered. Setting isSending = false.");
            isSending = false;
            StateHasChanged();
        }
        // --- 修改：仅在 Level 3 输出函数结束信息 ---
        if (outputLevel == 3) AppendMessageToOutput("DEBUG: SendMessageAsync finished.");
    }

    private async Task<string> CallGeminiApiAsync(string input)
    {
        // --- 修改：仅在 Level 3 输出进入函数信息 ---
        if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync entered.");
        HttpResponseMessage? response = null;
        string responseContent = "Error: Response was null.";

        try
        {
            // Get current config values
            string apiUrl = string.IsNullOrEmpty(geminiApiUrl) ? defaultGeminiApiUrl : geminiApiUrl;
            string apiKey = string.IsNullOrEmpty(geminiApiKey) ? defaultGeminiApiKey : geminiApiKey;
            string currentModelName = string.IsNullOrEmpty(modelName) ? defaultModelName : modelName;
            // --- 修改：仅在 Level 3 输出配置信息 ---
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: CallGeminiApiAsync - Configs: URL='{apiUrl}', Key='{(string.IsNullOrEmpty(apiKey) ? "EMPTY" : "******")}', Model='{currentModelName}'.");

            var currentMessages = new List<ChatMessage>();

            if (!string.IsNullOrWhiteSpace(systemPrompt))
            {
                currentMessages.Add(new ChatMessage { role = "system", content = systemPrompt });
                if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Added system prompt to current request messages.");
            }

            if (!enableHistoryLimit || historyCount > 0)
            {
                 currentMessages.AddRange(chatHistory.Where(m => m.role != "system"));
                 if (outputLevel == 3) AppendMessageToOutput($"DEBUG: CallGeminiApiAsync - Added {chatHistory.Count} messages from history to request.");
            } else {
                 if (outputLevel == 3) AppendMessageToOutput($"DEBUG: CallGeminiApiAsync - History limit enabled with count 0. Skipping adding history messages to request.");
            }

            currentMessages.Add(new ChatMessage { role = "user", content = input });
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Added user message to current request messages.");

            if (enableHistoryLimit && historyCount > 0)
            {
                 int messagesToKeep = historyCount * 2;
                 if (!string.IsNullOrWhiteSpace(systemPrompt)) messagesToKeep += 1;
                 int minMessages = string.IsNullOrWhiteSpace(systemPrompt) ? 1 : 2;

                 while (currentMessages.Count > messagesToKeep && currentMessages.Count > minMessages)
                 {
                     int removeIndex = string.IsNullOrWhiteSpace(systemPrompt) ? 0 : 1;
                     if (currentMessages.Count > removeIndex) currentMessages.RemoveAt(removeIndex);
                     else break;
                 }
                 if (outputLevel == 3) AppendMessageToOutput($"DEBUG: CallGeminiApiAsync - Message list limited (count > 0) for API call. Count: {currentMessages.Count}.");
            }
            else if (!enableHistoryLimit)
            {
                 // --- 修改：仅在 Level 3 输出历史限制禁用信息 ---
                 if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - History limit disabled.");
            }


            var requestBody = new Dictionary<string, object>
            {
                { "model", currentModelName },
                { "messages", currentMessages }
            };
            if (temperature.HasValue) requestBody["temperature"] = temperature.Value;
            if (topP.HasValue) requestBody["top_p"] = topP.Value;
            if (topK.HasValue) requestBody["top_k"] = topK.Value;
            // --- 修改：仅在 Level 3 输出请求体构建信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Request body built.");

            string jsonContent = JsonConvert.SerializeObject(requestBody, Newtonsoft.Json.Formatting.Indented);
            // --- 修改：仅在 Level 2 或 3 输出请求体 ---
            if (outputLevel >= 2)
            {
                AppendMessageToOutput("Request Body:\n" + jsonContent);
            }
            // --- 修改：仅在 Level 3 输出序列化信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Request body serialized.");

            // Prepare and Send HTTP request
            // --- 修改：仅在 Level 3 输出准备请求信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Preparing HttpRequestMessage...");
            using var request = new HttpRequestMessage(HttpMethod.Post, apiUrl);
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", apiKey);
            request.Content = new StringContent(jsonContent, Encoding.UTF8, "application/json");
            // --- 修改：仅在 Level 3 输出请求准备完成信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - HttpRequestMessage prepared.");

            // --- 修改：仅在 Level 3 输出发送请求信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - >>>>>>>> ABOUT TO SEND HTTP REQUEST via Http.SendAsync <<<<<<<<");
            response = await Http.SendAsync(request);
            // --- 修改：仅在 Level 3 输出请求完成信息 ---
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: CallGeminiApiAsync - Http.SendAsync completed. Status Code: {(response?.StatusCode.ToString() ?? "N/A")}");

            if (response != null)
            {
                responseContent = await response.Content.ReadAsStringAsync();
                // --- 修改：仅在 Level 3 输出读取响应内容信息 ---
                if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Response content read.");

                if (!response.IsSuccessStatusCode)
                {
                    // --- 修改：仅在 Level 3 输出非成功状态码信息 ---
                    if (outputLevel == 3) AppendMessageToOutput($"DEBUG: CallGeminiApiAsync - Non-success status code: {response.StatusCode}. Response: {responseContent}");
                    return $"Error: API request failed with status {response.StatusCode}. Response: {responseContent}";
                }

                // Process successful response
                // --- 修改：仅在 Level 3 输出解析响应信息 ---
                if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Parsing successful response.");
                dynamic responseObject = JsonConvert.DeserializeObject(responseContent) ?? throw new Exception("Failed to parse API response (result was null).");

                string? geminiResponseText = null;
                // Try parsing 'choices' structure (OpenAI style)
                if (responseObject.choices != null && responseObject.choices.Count > 0 && responseObject.choices[0].message != null && responseObject.choices[0].message.content != null)
                {
                    geminiResponseText = responseObject.choices[0].message.content;
                    // --- 修改：仅在 Level 3 输出解析路径信息 ---
                    if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Parsed 'choices[0].message.content'.");
                }
                // Try parsing 'candidates' structure (Google AI/Gemini style)
                else if (responseObject.candidates != null && responseObject.candidates.Count > 0 && responseObject.candidates[0].content != null && responseObject.candidates[0].content.parts != null && responseObject.candidates[0].content.parts.Count > 0 && responseObject.candidates[0].content.parts[0].text != null)
                {
                    geminiResponseText = responseObject.candidates[0].content.parts[0].text;
                     // --- 修改：仅在 Level 3 输出解析路径信息 ---
                    if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Parsed 'candidates[0].content.parts[0].text'.");
                }

                if (geminiResponseText != null)
                {
                    chatHistory.Add(new ChatMessage { role = "assistant", content = geminiResponseText });
                    // --- 修改：仅在 Level 3 输出添加助手消息到历史记录信息 ---
                    if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Added assistant message to history.");
                    // --- 修改：仅在 Level 3 输出成功完成信息 ---
                    if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync finished successfully.");
                    return geminiResponseText;
                }
                else
                {
                     // --- 修改：仅在 Level 3 输出未知格式信息 ---
                     if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Unexpected API response format. Raw response: " + responseContent);
                     errorMessage = "Error: Unexpected API response format.";
                     throw new Exception("Unexpected API response format. Could not find message content.");
                }
            }
            else
            {
                 // --- 修改：仅在 Level 3 输出空响应对象信息 ---
                 if (outputLevel == 3) AppendMessageToOutput("DEBUG: CallGeminiApiAsync - Response object was null after SendAsync.");
                 errorMessage = "Error: No response received from API.";
            }
        }
        catch (HttpRequestException httpEx)
        {
            // --- 修改：仅在 Level 3 输出 HttpRequestException 信息 ---
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: CallGeminiApiAsync - HttpRequestException: {httpEx.Message}");
            if (response != null) {
                 try { responseContent = await response.Content.ReadAsStringAsync(); } catch { /* Ignore */ }
                 if (outputLevel == 3) AppendMessageToOutput($"DEBUG: CallGeminiApiAsync - Response content during exception: {responseContent}");
            } else {
                 responseContent = $"HttpRequestException: {httpEx.Message}";
            }
            errorMessage = $"Network Error: {httpEx.Message}";
            return $"Error: {httpEx.Message}";
        }
        catch (Exception ex)
        {
            // --- 修改：仅在 Level 3 输出通用异常信息 ---
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: CallGeminiApiAsync - General Exception: {ex.Message}\nStackTrace: {ex.StackTrace}");
            errorMessage = $"An unexpected error occurred: {ex.Message}";
            return $"Error: {ex.Message}";
        }

        return responseContent; // Fallback return
    }

    private void AppendMessageToOutput(string message)
    {
        chatOutputBuilder.AppendLine(message);
        InvokeAsync(StateHasChanged);
    }

    private void SaveChatLog(string userInput, string geminiResponse)
    {
        if (chatLogsCollection == null)
        {
             // --- 修改：仅在 Level 3 输出跳过保存信息 ---
             if (outputLevel == 3) AppendMessageToOutput("DEBUG: SaveChatLog skipped - MongoDB not initialized.");
             return;
        }

        try
        {
            var document = new BsonDocument
            {
                { "Timestamp", DateTime.UtcNow },
                { "UserInput", userInput },
                { "GeminiResponse", geminiResponse },
                { "Model", string.IsNullOrEmpty(modelName) ? defaultModelName : modelName },
                { "SystemPrompt", systemPrompt ?? string.Empty }
            };
            chatLogsCollection.InsertOne(document);
            // --- 修改：仅在 Level 3 输出保存成功信息 ---
            if (outputLevel == 3) AppendMessageToOutput("DEBUG: Chat log saved to MongoDB.");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving chat log to MongoDB: {ex.Message}";
            // --- 修改：仅在 Level 3 输出保存错误信息 ---
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: Error saving chat log: {ex.Message}");
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    public class ChatMessage
    {
        public string role { get; set; } = string.Empty;
        public string content { get; set; } = string.Empty;
    }

    private void UpdatePersistentHistory(string userInput, string assistantResponse)
    {
        if (enableHistoryLimit && historyCount == 0)
        {
            chatHistory.Clear();
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: UpdatePersistentHistory - Persistent history cleared (limit is 0).");
        }

        chatHistory.Add(new ChatMessage { role = "user", content = userInput });
        chatHistory.Add(new ChatMessage { role = "assistant", content = assistantResponse });
        if (outputLevel == 3) AppendMessageToOutput($"DEBUG: UpdatePersistentHistory - Added user/assistant messages. History count: {chatHistory.Count}");

        if (enableHistoryLimit && historyCount > 0)
        {
            int maxHistoryMessages = historyCount * 2;
            while (chatHistory.Count > maxHistoryMessages && maxHistoryMessages >= 0)
            {
                chatHistory.RemoveAt(0);
            }
            if (outputLevel == 3) AppendMessageToOutput($"DEBUG: UpdatePersistentHistory - Persistent history limited (count > 0) to {chatHistory.Count} messages.");
        }
    }
}